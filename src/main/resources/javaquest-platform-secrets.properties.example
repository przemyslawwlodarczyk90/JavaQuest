# Skopiuj do javaquest-platform-secrets.properties (ten plik jest w .gitignore) i uzupelnij.
# Haslo do Gmaila to "haslo aplikacji" (Konto Google -> Bezpieczenstwo -> Hasla aplikacji).
spring.mail.username=twoj_adres@gmail.com
spring.mail.password=haslo_aplikacji_bez_spacji_lub_ze_spacjami

# Sekret podpisu JWT (min. 32 znaki). Wygeneruj np.: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Bez tego wpisu aplikacja losuje sekret przy KAZDYM starcie (zalogowani wylogowuja sie po restarcie).
auth.jwt.secret=
